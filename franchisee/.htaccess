# Espace franchisé (/social_franchisee) : pages statiques ; l'API est celle de /social.
DirectoryIndex index.html

# Les pages sous une adresse propre, sans « .dc.html » : /social_franchisee/calendrier, publier,
# operations, instagram, commentaires, messages, avis-google (le paramètre ?shop= suit). Les anciennes adresses en .dc.html restent valables
# (liens de l'ERP, favoris) ; la page les affiche alors sous leur nom propre.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # « publier/ » → « publier » (l'adresse demandée, sans la barre finale : jamais le chemin du disque).
  RewriteCond %{REQUEST_URI} ^(.*/(calendrier|publier|operations|instagram|commentaires|messages|avis-google))/$
  RewriteRule ^ %1 [R=302,L]
  RewriteRule ^calendrier$ Calendrier.dc.html [L]
  RewriteRule ^publier$ Publier.dc.html [L]
  RewriteRule ^operations$ Campagnes.dc.html [L]
  RewriteRule ^instagram$ Instagram.dc.html [L]
  RewriteRule ^commentaires$ Commentaires.dc.html [L]
  RewriteRule ^messages$ Messages.dc.html [L]
  RewriteRule ^avis-google$ Google.dc.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
